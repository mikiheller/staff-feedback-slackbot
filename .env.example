# ---- Slack ----
# From your Slack app's "Basic Information" page
SLACK_SIGNING_SECRET=

# "Bot User OAuth Token" from OAuth & Permissions (starts with xoxb-)
# Used to receive your DMs and post drafts back to you.
SLACK_BOT_TOKEN=

# "User OAuth Token" from OAuth & Permissions (starts with xoxp-)
# Used to send the final message AS YOU to your staff. This is the magic
# that makes outgoing messages look like normal messages from you.
SLACK_USER_TOKEN=

# Your own Slack user ID (e.g. U01ABC2DEF3). The bot will ONLY respond to you.
# Find it: in Slack, click your profile -> ... menu -> "Copy member ID"
OWNER_SLACK_USER_ID=

# ---- AI ----
# No key needed in production! When deployed to Vercel, the AI Gateway
# automatically uses OIDC for auth. For local dev only, you can optionally
# set AI_GATEWAY_API_KEY (get one at https://vercel.com/d?to=/[team]/ai/api-keys).

# ---- Storage (Upstash Redis via Vercel Marketplace) ----
# These are auto-set when you add Upstash from the Vercel Marketplace.
# (Not used yet — will be needed for the iteration loop in step 5.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
